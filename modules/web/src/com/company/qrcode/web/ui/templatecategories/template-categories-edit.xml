<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://templateCategoriesEdit.caption"
        focusComponent="form"
        messagesPack="com.company.qrcode.web.ui.templatecategories">
    <data>
        <instance id="templateCategoriesDc"
                  class="com.company.qrcode.entity.TemplateCategories">
            <view extends="_local">
                <property name="share" view="_minimal"/>
            </view>
            <loader/>
            <collection id="shareDc" property="share"/>
        </instance>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="editActions" spacing="true">
        <form id="form" dataContainer="templateCategoriesDc" captionPosition="TOP" align="MIDDLE_CENTER" width="100%">
            <column width="100%">
                <textField id="nameField" property="name" caption="Название"/>
                <lookupField id="accessTypeField" property="accessType" caption="Тип доступа" nullOptionVisible="false"/>
                <checkBox id="activeCheckBox" property="active" caption="Активен"/>
            </column>
        </form>
        <groupBox id="shareBox" caption="msg://com.company.qrcode.entity/RecipientList.share" visible="false">
            <table id="shareTable" dataContainer="shareDc" width="100%" height="200px">
                <actions>
                    <action id="add" type="add"/>
                    <action id="exclude" type="exclude"/>
                </actions>
                <columns>
                    <column id="login"/>
                    <column id="name"/>
                </columns>
                <buttonsPanel align="MIDDLE_CENTER">
                    <button action="shareTable.add"/>
                    <button action="shareTable.exclude"/>
                </buttonsPanel>
            </table>
        </groupBox>
        <hbox id="editActions" spacing="true" align="MIDDLE_CENTER">
            <button id="commitAndCloseBtn" action="windowCommitAndClose" align="MIDDLE_CENTER"/>
            <button id="closeBtn" action="windowClose" align="MIDDLE_CENTER"/>
        </hbox>
    </layout>
</window>
