<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://selectTextTemplateBrowse.caption"
        messagesPack="com.company.qrcode.web.ui.texttemplate">
    <data readOnly="true">
        <collection id="selectedTextTemplatesDc"
                    class="com.company.qrcode.entity.TextTemplate"/>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="selectedTemplates">
        <groupTable id="selectedTemplates" dataContainer="selectedTextTemplatesDc" width="100%" height="100%" multiselect="true">
            <columns>
                <column id="content"/>
            </columns>
            <rows/>
        </groupTable>
        <buttonsPanel id="bottomButtonsPanel" alwaysVisible="true" width="100%">
            <button id="insertTemplates" caption="Вставить шаблон"/>
        </buttonsPanel>
    </layout>
</window>