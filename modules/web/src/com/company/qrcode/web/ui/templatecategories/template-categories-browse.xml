<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://templateCategoriesBrowse.caption"
        focusComponent="templateCategoriesesTable"
        messagesPack="com.company.qrcode.web.ui.templatecategories">
    <data readOnly="true">
        <collection id="templateCategoriesesDc"
                    class="com.company.qrcode.entity.TemplateCategories">
            <view extends="_local"/>
            <loader id="templateCategoriesesDl">
                <query>
                    <![CDATA[select e from qrcode$TemplateCategories e]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="templateCategoriesesTable"
            spacing="true">
        <filter id="filter"
                applyTo="templateCategoriesesTable"
                dataLoader="templateCategoriesesDl">
            <properties include=".*"/>
        </filter>
        <groupTable id="templateCategoriesesTable"
                    width="100%"
                    dataContainer="templateCategoriesesDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column id="name"/>
            </columns>
            <rowsCount/>
            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="createBtn" action="templateCategoriesesTable.create"/>
                <button id="editBtn" action="templateCategoriesesTable.edit"/>
                <button id="removeBtn" action="templateCategoriesesTable.remove"/>
            </buttonsPanel>
        </groupTable>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
