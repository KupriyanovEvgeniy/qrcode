<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://recipientListEdit.caption"
        focusComponent="form"
        messagesPack="com.company.qrcode.web.ui.recipientlist">
    <data>
        <instance id="recipientListDc"
                  class="com.company.qrcode.entity.RecipientList">
            <view extends="_local">
                <property name="owner" view="_minimal"/>
                <property name="recipients" view="_minimal"/>
                <property name="share" view="_minimal"/>
            </view>
            <loader/>
            <collection id="recipientsDc" property="recipients"/>
            <collection id="shareDc" property="share"/>
        </instance>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="editActions" spacing="true">
        <form id="form" dataContainer="recipientListDc">
            <column width="550px">
                <textField id="nameField" property="name"/>
                <lookupField id="accessTypeField" property="accessType"/>
            </column>
        </form>
        <groupBox id="recipientsBox" caption="msg://com.company.qrcode.entity/RecipientList.recipients">
            <table id="recipientsTable" dataContainer="recipientsDc" width="100%" height="200px">
                <actions>
                    <action id="add" type="add"/>
                    <action id="exclude" type="exclude"/>
                </actions>
                <columns>
                    <column id="login"/>
                    <column id="name"/>
                </columns>
                <buttonsPanel>
                    <button action="recipientsTable.add"/>
                    <button action="recipientsTable.exclude"/>
                </buttonsPanel>
            </table>
        </groupBox>
        <groupBox id="shareBox" caption="msg://com.company.qrcode.entity/RecipientList.share" visible="false">
            <table id="shareTable" dataContainer="shareDc" width="100%" height="200px">
                <actions>
                    <action id="add" type="add"/>
                    <action id="exclude" type="exclude"/>
                </actions>
                <columns>
                    <column id="login"/>
                    <column id="name"/>
                </columns>
                <buttonsPanel>
                    <button action="shareTable.add"/>
                    <button action="shareTable.exclude"/>
                </buttonsPanel>
            </table>
        </groupBox>
        <hbox id="editActions" spacing="true">
            <button id="commitAndCloseBtn" action="windowCommitAndClose"/>
            <button id="closeBtn" action="windowClose"/>
        </hbox>
    </layout>
</window>
