<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://textTemplateEdit.caption"
        focusComponent="form"
        messagesPack="com.company.qrcode.web.ui.texttemplate">
    <data>
        <instance id="textTemplateDc"
                  class="com.company.qrcode.entity.TextTemplate">
            <view extends="_local"/>
            <loader/>
        </instance>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="editActions" spacing="true">
        <form id="form" dataContainer="textTemplateDc">
            <column width="350px">
                <textField id="codeField" property="code"/>
                <textArea id="contentField" property="content" rows="5"/>
                <textField id="categoryField" property="category"/>
                <checkBox id="activeField" property="active"/>
            </column>
        </form>
        <hbox id="editActions" spacing="true">
            <button id="commitAndCloseBtn" action="windowCommitAndClose"/>
            <button id="closeBtn" action="windowClose"/>
        </hbox>
    </layout>
</window>
