<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://textTemplateEdit.caption"
        focusComponent="form"
        messagesPack="com.company.qrcode.web.ui.texttemplate">
    <data>
        <instance id="textTemplateDc" class="com.company.qrcode.entity.TextTemplate">
            <view extends="_local">
                <property name="owner" view="_minimal"/>
                <property name="share" view="_minimal"/>
                <property name="category" view="_minimal"/>
            </view>
            <loader/>
            <collection id="shareDc" property="share"/>
        </instance>
        <collection id="categoriesDc" class="com.company.qrcode.entity.TemplateCategories" view="_minimal">
            <loader id="categoriesDl">
                <query>
                    <![CDATA[select e from qrcode$TemplateCategories e]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="editActions" spacing="true">
        <form id="form" dataContainer="textTemplateDc">
            <column width="350px">
                <textField id="codeField" property="code"/>
                <textArea id="contentField" property="content" rows="5"/>
                <lookupPickerField id="categoryPickerField" dataContainer="textTemplateDc" property="category" optionsContainer="categoriesDc"/>
                <checkBox id="activeField" property="active"/>
                <lookupField id="accessTypeField" property="accessType"/>
            </column>
        </form>
        <groupBox id="shareBox" caption="msg://com.company.qrcode.entity/RecipientList.share" visible="false">
            <table id="shareTable" dataContainer="shareDc" width="100%" height="200px">
                <actions>
                    <action id="add" type="add"/>
                    <action id="exclude" type="exclude"/>
                </actions>
                <columns>
                    <column id="login"/>
                    <column id="name"/>
                </columns>
                <buttonsPanel>
                    <button action="shareTable.add"/>
                    <button action="shareTable.exclude"/>
                </buttonsPanel>
            </table>
        </groupBox>
        <hbox id="editActions" spacing="true">
            <button id="commitAndCloseBtn" action="windowCommitAndClose"/>
            <button id="closeBtn" action="windowClose"/>
        </hbox>
    </layout>
</window>
