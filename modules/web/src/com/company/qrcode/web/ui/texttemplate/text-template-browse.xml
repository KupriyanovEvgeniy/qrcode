<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://textTemplateBrowse.caption"
        focusComponent="textTemplatesTable"
        messagesPack="com.company.qrcode.web.ui.texttemplate">
    <data readOnly="true">
        <collection id="textTemplatesDc"
                    class="com.company.qrcode.entity.TextTemplate">
            <view extends="_local"/>
            <loader id="textTemplatesDl">
                <query>
                    <![CDATA[select e from qrcode$TextTemplate e]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="textTemplatesTable"
            spacing="true">
        <filter id="filter"
                applyTo="textTemplatesTable"
                dataLoader="textTemplatesDl">
            <properties include=".*"/>
        </filter>
        <groupTable id="textTemplatesTable"
                    width="100%"
                    dataContainer="textTemplatesDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column id="code"/>
                <column id="content"/>
                <column id="category"/>
                <column id="active"/>
            </columns>
            <rowsCount/>
            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="createBtn" action="textTemplatesTable.create"/>
                <button id="editBtn" action="textTemplatesTable.edit"/>
                <button id="removeBtn" action="textTemplatesTable.remove"/>
            </buttonsPanel>
        </groupTable>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
