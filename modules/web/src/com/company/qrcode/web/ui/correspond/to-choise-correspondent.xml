<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://toChoiseCorrespondent.caption"
        messagesPack="com.company.qrcode.web.ui">
    <data>
        <collection id="recipientUsersListsDc" class="com.company.qrcode.entity.RecipientUserList">
            <view extends="_local">
                <property name="recipients" view="_local"/>
                <property name="share"/>
            </view>
            <loader id="recipientUserListsDl">
                <query>
                    <![CDATA[SELECT e FROM qrcode$RecipientList e LEFT JOIN e.share s where e.accessType='A' or e.owner.id=:id or s.id=:id]]>
                </query>
            </loader>
            <collection id="usersInListDc" property="recipients"/>
        </collection>
        <keyValueCollection id="selectedItemsDc">
            <properties>
                <property name="entity"/>
                <property name="name"/>
                <property name="type"/>
            </properties>
        </keyValueCollection>

        <collection id="recipientsIndividualListsDc" class="com.company.qrcode.entity.RecipientIndividualList">
            <view extends="_local">
                <property name="recipients" view="_local"/>
                <property name="share"/>
            </view>
            <loader id="recipientsIndividualListsDl">
                <query>
                    <![CDATA[SELECT e FROM qrcode$RecipientIndividualList e LEFT JOIN e.share s where e.accessType='A' or e.owner.id=:id or s.id=:id]]>
                </query>
            </loader>
            <collection id="individualInListDc" property="recipients"/>
        </collection>

        <collection id="recipientCompaniesListsDc" class="com.company.qrcode.entity.RecipientCompanyList">
            <view extends="_local">
                <property name="recipients" view="_local"/>
                <property name="share"/>
            </view>
            <loader id="recipientCompaniesListsDl">
                <query><![CDATA[
            SELECT e FROM qrcode$RecipientCompanyList e
            LEFT JOIN e.share s
            WHERE e.accessType='A' OR e.owner.id=:id OR s.id=:id
        ]]></query>
            </loader>
            <collection id="companiesInListDc" property="recipients"/>
        </collection>

        <collection id="recipientDepartmentsListsDc" class="com.company.qrcode.entity.RecipientDepartmentList">
            <view extends="_local">
                <property name="recipients" view="_local"/>
                <property name="share"/>
            </view>
            <loader id="recipientDepartmentsListsDl">
                <query><![CDATA[
            SELECT e FROM qrcode$RecipientDepartmentList e
            LEFT JOIN e.share s
            WHERE e.accessType='A' OR e.owner.id=:id OR s.id=:id
        ]]></query>
            </loader>
            <collection id="departmentsInListDc" property="recipients"/>
        </collection>

        <collection id="recipientUniversalListsDc"
                    class="com.company.qrcode.entity.RecipientUniversalList">
            <view extends="_local">
                <property name="recipients" view="_local"/>
                <property name="share"/>
            </view>
            <loader id="recipientUniversalListsDl">
                <query><![CDATA[
            SELECT e FROM qrcode$RecipientUniversalList e
            LEFT JOIN e.share s
            WHERE e.accessType='A' OR e.owner.id=:id OR s.id=:id
        ]]></query>
            </loader>

            <collection id="universalItemsDc" property="recipients"/>
        </collection>

    </data>

    <layout spacing="true">
        <vbox id="mainBox" height="100%" spacing="true">
            <button id="addOneBtn" caption="Добавить адресата"/>
            <button id="createListBtn" caption="Создать список"/>
            <groupBox id="choiseUsersBox" caption="msg://choiseUsersBox.caption" height="100%">
                <table id="selectedTable"
                       dataContainer="selectedItemsDc"
                       width="100%" height="100%" multiselect="true">
                    <columns>
                        <column id="name" caption="msg://selectedTable.name"/>
                        <column id="type" caption="msg://selectedTable.type"/>
                    </columns>
                    <rows/>
                </table>
            </groupBox>
            <buttonsPanel id="add_remove_lists_button_panel" align="MIDDLE_CENTER">
                <button id="addList" icon="font-icon:ARROW_UP" align="MIDDLE_CENTER"/>
                <button id="removeList" icon="font-icon:ARROW_DOWN" align="MIDDLE_CENTER"/>
            </buttonsPanel>
            <groupBox id="choiseListsBox" height="100%" width="100%">
                <tabSheet id="entityTabs" width="100%" height="100%">
                    <tab id="usersTab" caption="Сотрудники">
                        <split id="usersListsSplit" orientation="horizontal" locked="true">
                            <vbox id="usersViewList" height="100%" width="100%" expand="usersListsTable">
                                <label id="usersLabelList" value="Списки:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="usersListsTable" dataContainer="recipientUsersListsDc" width="100%">
                                    <columns>
                                        <column id="name" caption="msg://entityTabs.nameList"/>
                                    </columns>
                                </table>
                            </vbox>
                            <vbox id="usersViewDetailList" height="100%" width="100%" expand="usersListsDetailTable">
                                <label id="usersLabelDetailList" value="Пользователи в списке:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="usersListsDetailTable" dataContainer="usersInListDc" width="100%" height="100%" editable="false">
                                    <columns>
                                        <column id="name"/>
                                    </columns>
                                </table>
                            </vbox>
                        </split>
                    </tab>
                    <tab id="individualsTab" caption="Физ лица">
                        <split id="individualsListSplit" orientation="horizontal" locked="true">
                            <vbox id="individualsViewList" height="100%" width="100%" expand="individualsListTable">
                                <label id="individualsLabelList" value="Списки:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="individualsListTable" dataContainer="recipientsIndividualListsDc" width="100%" height="100%">
                                    <columns>
                                        <column id="name" caption="msg://entityTabs.nameList"/>
                                    </columns>
                                </table>
                            </vbox>
                            <vbox id="individualsViewDetailList" height="100%" width="100%" expand="individualsListsDetailTable">
                                <label id="individualsLabelDetailList" value="Пользователи в списке:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="individualsListsDetailTable" dataContainer="individualInListDc" width="100%" height="100%" editable="false">
                                    <columns>
                                        <column id="name"/>
                                    </columns>
                                </table>
                            </vbox>
                        </split>
                    </tab>

                    <tab id="companiesTab" caption="Юр лица">
                        <split id="companiesListSplit" orientation="horizontal" locked="true">

                            <vbox id="companiesViewList" height="100%" width="100%" expand="companiesListTable">
                                <label id="companiesLabelList" value="Списки:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="companiesListTable"
                                       dataContainer="recipientCompaniesListsDc"
                                       width="100%" height="100%">
                                    <columns>
                                        <column id="name" caption="msg://entityTabs.nameList"/>
                                    </columns>
                                </table>
                            </vbox>

                            <vbox id="companiesViewDetailList" height="100%" width="100%" expand="companiesListsDetailTable">
                                <label id="companiesLabelDetailList" value="Юр лица в списке:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="companiesListsDetailTable"
                                       dataContainer="companiesInListDc"
                                       width="100%" height="100%" editable="false">
                                    <columns>
                                        <column id="name"/>
                                    </columns>
                                </table>
                            </vbox>

                        </split>
                    </tab>

                    <tab id="departmentsTab" caption="Подразделения">
                        <split id="departmentsListSplit" orientation="horizontal" locked="true">

                            <vbox id="departmentsViewList" height="100%" width="100%" expand="departmentsListTable">
                                <label id="departmentsLabelList" value="Списки:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="departmentsListTable"
                                       dataContainer="recipientDepartmentsListsDc"
                                       width="100%" height="100%">
                                    <columns>
                                        <column id="name" caption="msg://entityTabs.nameList"/>
                                    </columns>
                                </table>
                            </vbox>

                            <vbox id="departmentsViewDetailList" height="100%" width="100%" expand="departmentsListsDetailTable">
                                <label id="departmentsLabelDetailList" value="Подразделения в списке:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="departmentsListsDetailTable"
                                       dataContainer="departmentsInListDc"
                                       width="100%" height="100%" editable="false">
                                    <columns>
                                        <column id="name"/>
                                    </columns>
                                </table>
                            </vbox>

                        </split>
                    </tab>

                    <tab id="universalTab" caption="Пользовательские списки">
                        <split id="universalSplit" orientation="horizontal" locked="true">

                            <vbox id="universalViewList" height="100%" width="100%" expand="universalListsTable">
                                <label id="universalLabelList" value="Списки:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="universalListsTable"
                                       dataContainer="recipientUniversalListsDc"
                                       width="100%" height="100%">
                                    <columns>
                                        <column id="name" caption="msg://entityTabs.nameList"/>
                                    </columns>
                                </table>
                            </vbox>

                            <vbox id="universalViewDetailList" height="100%" width="100%" expand="universalItemsTable">
                                <label id="universalLabelDetailList" value="Элементы списка:" align="MIDDLE_CENTER" stylename="h4"/>
                                <table id="universalItemsTable"
                                       dataContainer="universalItemsDc"
                                       width="100%" height="100%">
                                    <columns>
                                        <column id="entityName" caption="Название"/>
                                        <column id="entityType" caption="Тип"/>
                                    </columns>
                                </table>
                            </vbox>

                        </split>
                    </tab>
                </tabSheet>
            </groupBox>
            <hbox id="lookupActions" spacing="true">
                <button id="selectBtn" caption="Выбрать"/>
                <button id="cancelBtn" caption="Отмена"/>
            </hbox>
        </vbox>
    </layout>
</window>