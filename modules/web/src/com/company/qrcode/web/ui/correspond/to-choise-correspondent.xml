<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://toChoiseCorrespondent.caption"
        messagesPack="com.company.qrcode.web.ui">
    <data>
        <collection id="selectedUsersDc" class="com.haulmont.cuba.security.entity.User" view="_local"/>
        <collection id="recipientListsDc" class="com.company.qrcode.entity.RecipientList">
            <view extends="_local">
                <property name="recipients" view="_local"/>
                <property name="share"/>
            </view>
            <loader id="recipientListsDl">
                <query>
                    <![CDATA[SELECT e FROM qrcode$RecipientList e LEFT JOIN e.share s where e.accessType='A' or e.owner.id=:id or s.id=:id]]>
                </query>
            </loader>
            <collection id="usersInListDc" property="recipients"/>
        </collection>
    </data>
    <layout spacing="true">
        <vbox id="mainBox" height="100%" spacing="true">
            <groupBox id="choiseUsersBox" caption="Выбранные пользователи" height="100%">
                <table id="usersTable" dataContainer="selectedUsersDc" width="100%" height="100%" multiselect="true">
                    <columns>
                        <column id="id"/>
                        <column id="login"/>
                    </columns>
                    <rows/>
                </table>
            </groupBox>
            <buttonsPanel id="add_remove_lists_button_panel" align="MIDDLE_CENTER">
                <button id="addList" icon="font-icon:ARROW_UP" align="MIDDLE_CENTER"/>
                <button id="removeList" icon="font-icon:ARROW_DOWN" align="MIDDLE_CENTER"/>
            </buttonsPanel>
            <groupBox id="choiseListsBox" height="100%">
                <split id="listsSplit" orientation="horizontal" locked="true">
                    <vbox id="viewList" height="100%" width="100%" expand="listsTable">
                        <label id="labelList" value="Списки:" align="MIDDLE_CENTER" stylename="h4"/>
                        <table id="listsTable" dataContainer="recipientListsDc" width="100%" height="100%">
                            <columns>
                                <column id="id"/>
                                <column id="name"/>
                            </columns>
                        </table>
                    </vbox>
                    <vbox id="viewDetailList" height="100%" width="100%" expand="listsDetailTable">
                        <label id="labelDetailList" value="Пользователи в списке:" align="MIDDLE_CENTER" stylename="h4"/>
                        <table id="listsDetailTable" dataContainer="usersInListDc" width="100%" height="100%" editable="false">
                            <columns>
                                <column id="id"/>
                                <column id="name"/>
                            </columns>
                        </table>
                    </vbox>
                </split>
            </groupBox>
        </vbox>
    </layout>
</window>