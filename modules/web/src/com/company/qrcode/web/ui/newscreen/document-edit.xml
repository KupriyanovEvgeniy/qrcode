<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://documentEdit.caption"
        messagesPack="com.company.qrcode.web.ui.newscreen">
    <data>
        <keyValueCollection id="addresseesDc">
            <properties>
                <property name="entity"/>
                <property name="name"/>
                <property name="type"/>
            </properties>
        </keyValueCollection>
    </data>
    <layout>
        <groupBox id="adressTableGroupBox" caption="msg://addresseesTable.caption" width="100%" height="100%">
            <groupTable id="addresseesTable"
                   dataContainer="addresseesDc"
                   width="100%" height="100%"
                   multiselect="true">

                <columns>
                    <column id="type" caption="msg://addresseesTable.type"/>
                    <column id="name" caption="msg://addresseesTable.name"/>
                </columns>

                <buttonsPanel id="adressBtnPanel">
                    <button id="addBtn" caption="msg://addBtn"/>
                    <button id="removeBtn" caption="msg://removeBtn"/>
                </buttonsPanel>
            </groupTable>
        </groupBox>

    </layout>
</window>